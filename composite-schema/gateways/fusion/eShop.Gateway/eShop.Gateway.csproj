<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Generated by install.sh when needed (gitignored): net11 retarget +
       runtime-async for BENCH_GATEWAY_DOTNET=11 (the fusion-nightly-net11
       build), and FUSION_16_7_OR_GREATER when the resolved HotChocolate
       version is 16.7 or greater. Absent for plain `dotnet build` on stable
       pins, which stays on net10.0 (TargetFramework from
       composite-schema/Directory.Build.props) with the ModifyCostOptions
       call in Program.cs compiled out. -->
  <Import Project="bench.props" Condition="Exists('bench.props')" />

  <PropertyGroup>
    <RootNamespace>eShop.Gateway</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore.Pipeline" Version="16.1.3" />
    <PackageReference Include="HotChocolate.Fusion.AspNetCore" Version="16.1.3" />
    <PackageReference Include="HotChocolate.Fusion.Execution.Types" Version="16.1.3" />
    <PackageReference Include="HotChocolate.Fusion.Execution" Version="16.1.3" />
    <PackageReference Include="Microsoft.AspNetCore.HeaderPropagation" Version="10.0.6" />
  </ItemGroup>

</Project>
